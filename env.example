# Salin file ini jadi ".env" lalu isi nilainya. Jangan dibagikan atau di-upload ke GitHub.

# Buat bot lewat @BotFather di Telegram
TELEGRAM_BOT_TOKEN=isi_token_bot
# ID chat kamu (lihat README langkah 2). Hanya chat ini yang boleh menekan tombol.
TELEGRAM_CHAT_ID=isi_chat_id

# Pair yang dipantau, pisahkan dengan koma. Format  penyedia:simbol
#   yahoo:XAUUSD=X   yahoo:EURUSD=X   (gratis, tanpa API key)
#   twelvedata:EUR/USD                (perlu TWELVEDATA_API_KEY)
#   binance:PAXGUSDT                  (token emas di Binance, gratis)
PAIRS=yahoo:XAUUSD=X,yahoo:EURUSD=X

# Strategi: smc, scalp, atau keduanya (smc,scalp)
STRATEGIES=smc,scalp
# Timeframe dalam menit (5, 15, 30, atau 60) untuk tiap strategi
SMC_TF=15
SCALP_TF=5

# Mode order saat tombol BUY/SELL ditekan. Saat ini hanya: paper (simulasi, tanpa uang/broker)
EXECUTION=paper
# Tombol hanya berlaku sekian menit sejak sinyal muncul (harga cepat bergerak)
SIGNAL_TTL_MIN=10

# Opsional: hanya jika memakai twelvedata
TWELVEDATA_API_KEY=

# Opsional: catatan risiko dari AI di tiap sinyal (berbayar per pemakaian)
AI_NOTE=false
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
MAX_PER_DAY=30

# Berkas penyimpanan
JOURNAL_FILE=./journal.csv
STATE_FILE=./state.json
