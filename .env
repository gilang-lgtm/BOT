# Telegram
TELEGRAM_BOT_TOKEN=isi_token_bot_telegram_anda
TELEGRAM_CHAT_ID=isi_chat_id_anda

# Sumber Data Harga Gratis (Daftar gratis di twelvedata.com)
TWELVEDATA_API_KEY=isi_api_key_twelvedata_anda
PAIRS=twelvedata:XAU/USD
STRATEGIES=scalp,smc
SCALP_TF=5
SMC_TF=15

# Gemini API Gratis (Daftar gratis di aistudio.google.com)
GEMINI_API_KEY=isi_gemini_api_key_anda
GEMINI_MODEL=gemini-2.5-flash
AI_FILTER=true
MAX_PER_DAY=50

# Eksekusi Order: "paper" (simulasi) atau "metaapi" (auto-order MT4/MT5)
EXECUTION=metaapi
METAAPI_TOKEN=isi_token_metaapi_gratis_anda
METAAPI_ACCOUNT_ID=isi_account_id_mt5_anda
LOT_SIZE=0.01

SIGNAL_TTL_MIN=10
JOURNAL_FILE=./journal.csv
STATE_FILE=./state.json
